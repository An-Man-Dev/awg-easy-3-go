# Settings for docker-compose.yml, NOT the literal install.sh config format.
AWG_HOST=vpn.example.com
AWG_PORT=51820
AWG_UDP_PUBLISH_HOST=0.0.0.0
AWG_PANEL_PORT=8881
AWG_IPV6_MODE=auto
# Whole-container RAM limit, including both Go processes and tmpfs.
AWG_MEMORY_LIMIT=256m
AWG_DOCKER_SUBNET=172.30.88.0/24
AWG_DOCKER_IPV6_SUBNET=fd42:9::/64
# Initial database credential only; changing this file does not reset the stored password.
AWG_ADMIN_PASSWORD_PATH=./secrets/admin-password
# Set these when using compose.external.yml with a host reverse proxy.
AWG_PUBLIC_ORIGIN=
AWG_TRUSTED_PROXIES=

# Inside the container. The default is a private persistent file separate from SQLite.
# If overridden, mount the key or its persistent directory at this path.
AWG_TOTP_KEY_FILE=/data/totp.key
