# Settings for docker-compose.yml, NOT the literal install.sh config format.
AWG_HOST=vpn.example.com
AWG_PORT=51820
AWG_UDP_PUBLISH_HOST=0.0.0.0
AWG_PANEL_PORT=8881
AWG_IPV6_MODE=auto
AWG_DOCKER_SUBNET=172.30.88.0/24
AWG_DOCKER_IPV6_SUBNET=fd42:9::/64
AWG_ADMIN_PASSWORD_PATH=./secrets/admin-password
# Set these when using compose.external.yml with a host reverse proxy.
AWG_PUBLIC_ORIGIN=
AWG_TRUSTED_PROXIES=
